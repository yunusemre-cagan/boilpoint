# ── Database ──────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/obsidian_db?schema=public"

# ── NextAuth (Authentication) ──────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-secure-random-32-byte-secret"

# ── Initial Admin Seed Credentials ────────────────────────────
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="admin123"

# ── Media & Cloudinary (Optional, for image uploads) ─────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="obsidian-media"

# ── AI Services (Optional, for AI blog post & image creation) ──
GEMINI_API_KEY=""
HUGGINGFACE_API_KEY=""

# ── KV / Upstash Redis (Optional, for rate limiting) ─────────
KV_REST_API_URL=""
KV_REST_API_TOKEN=""
